{
  "name": "spiretone",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "pacing": "rolldown tools/pacing.ts --format esm --platform node --file node_modules/.cache/pacing.mjs --log-level warn && node node_modules/.cache/pacing.mjs"
  },
  "dependencies": {
    "@fontsource-variable/nunito": "^5.3.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/three": "^0.186.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
